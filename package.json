{
  "name": "opennest",
  "version": "0.1.0",
  "private": true,
  "description": "Your digital life. Your rules. An open-source, local-first personal digital workspace.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack",
    "build": "node scripts/next.mjs build --webpack && node scripts/pwa/build.mjs",
    "build:pwa": "node scripts/pwa/build.mjs",
    "start": "node scripts/next.mjs start",
    "lint": "node scripts/eslint.mjs .",
    "format": "node scripts/prettier.mjs --write .",
    "format:check": "node scripts/prettier.mjs --check .",
    "typecheck": "node scripts/next.mjs typegen && node scripts/tsc.mjs --noEmit && node scripts/tsc-packages.mjs",
    "typecheck:packages": "node scripts/tsc-packages.mjs",
    "check:browser-graph": "node scripts/check-browser-graph.mjs",
    "test": "node scripts/check-browser-graph.mjs && node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:e2e": "node scripts/e2e-stage-c.mjs && node scripts/e2e-pwa.mjs && node scripts/e2e-encryption.mjs",
    "test:e2e:encryption": "node scripts/e2e-encryption.mjs",
    "test:e2e:pwa": "node scripts/e2e-pwa.mjs",
    "benchmark:library": "node scripts/vitest.mjs run --config vitest.benchmark.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "happy-dom": "21.0.4"
  }
}
