{
  "name": "opennest",
  "version": "0.1.0",
  "private": true,
  "description": "Your digital life. Your rules. An open-source, local-first personal digital workspace.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start",
    "lint": "node scripts/eslint.mjs .",
    "format": "node scripts/prettier.mjs --write .",
    "format:check": "node scripts/prettier.mjs --check .",
    "typecheck": "node scripts/next.mjs typegen && node scripts/tsc.mjs --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "happy-dom": "21.0.4"
  }
}
